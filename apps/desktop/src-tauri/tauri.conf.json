{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dmVideoDownloader",
  "version": "0.1.0",
  "identifier": "com.dmkdevhub.dm-video-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "영상 다운로더",
      "width": 860,
      "height": 590,
      "minWidth": 480,
      "minHeight": 420,
      "theme": "Dark",
      "backgroundColor": "#10141c"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "capabilities": []
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
